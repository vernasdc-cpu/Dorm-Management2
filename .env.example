# Copy to .env and fill in real secrets. NEVER commit .env
APP_PORT=8080
DB_PORT=3307
PMA_PORT=8081

DB_HOST=db
DB_NAME=heart_dorm_db
DB_USER=heart_dorm
DB_PASS=change_me_strong_password
DB_ROOT_PASS=root_change_me

APP_ENV=development
APP_URL=http://localhost:8080
APP_KEY=change_me_32_char_random_string

# Email delivery for contract reminders.
# By default Docker Compose starts Mailpit, a local SMTP catcher.
# Open http://localhost:8025 to read captured reminder emails.
MAILPIT_PORT=8025
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_ENCRYPTION=none
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@heartdorm.local
MAIL_FROM_NAME=Heart Ladies Dormitory
MAIL_REPLY_TO=

# To deliver to real inboxes, replace the Mailpit settings with your SMTP
# provider's details, then restart the app (docker compose up -d --build app):
# MAIL_HOST=smtp.yourprovider.com
# MAIL_PORT=587
# MAIL_USER=your-smtp-user
# MAIL_PASS=your-smtp-password
# MAIL_ENCRYPTION=tls
# MAIL_FROM=no-reply@yourdomain.com
# MAIL_FROM_NAME=Heart Ladies Dormitory
# MAIL_REPLY_TO=
#
# Gmail / Google Workspace example (requires a 16-char App Password, not your
# normal password — enable 2-Step Verification first):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USER=you@gmail.com
# MAIL_PASS=abcdabcdabcdabcd
# MAIL_FROM=you@gmail.com      # must be the same Gmail account, Gmail rejects other senders
#
# Free transactional SMTP that DOES reach real inboxes (Brevo, 300/day free).
# Sign up, verify one sender address, then use its SMTP key:
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USER=your-brevo-login@example.com
# MAIL_PASS=your-brevo-smtp-key
# MAIL_FROM=the-address-you-verified@example.com
#
# Disposable inboxes (mail.tm, temp-mail.org, guerrilla mail, ...) only RECEIVE
# mail and hand out no SMTP credentials, so they cannot replace MAIL_HOST. They
# are fine as the *recipient* address while you test with a real relay.
#
# Verify the settings from the app container:
#   docker exec heart-dorm-app php /var/www/html/scripts/mail_test.php you@gmail.com
